# URL publique du backend Express (atteignable depuis le navigateur / le mobile).
# - Dev local : laissé vide → http://localhost:3001 utilisé par défaut.
# - Prod : URL HTTPS du backend déployé.
EXPO_PUBLIC_API_URL=

# URL publique du HTML embarqué (servi par le bundle web).
# - Dev natif : laissé vide → déduit de Constants.expoConfig.hostUri.
# - Prod : URL du HTML déployé (ex : https://app.agropilot.fr/agropilot-app.html).
EXPO_PUBLIC_HTML_URL=
