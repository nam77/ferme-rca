# Base de données
DATABASE_URL="postgresql://ferme_user:CHANGE_ME@localhost:5432/ferme_rca"

# JWT (génère une vraie clé en production : openssl rand -base64 64)
JWT_SECRET="dev-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3001
NODE_ENV=development

# CORS — origines web supplémentaires autorisées à appeler l'API (whitelist).
# Liste séparée par des virgules, SANS slash final. Ex :
#   CORS_ORIGINS="https://agri-pilot-v2.pages.dev,https://preview.agri-pilot.com"
# Les domaines de prod (agri-pilot.com, www.agri-pilot.com) sont TOUJOURS
# autorisés sans avoir à les lister ici. En dev (NODE_ENV != production),
# localhost/127.0.0.1 (tout port) est accepté automatiquement.
CORS_ORIGINS=""

# Cloudflare Pages — requis pour le déploiement automatisé via /api/admin/deploy
# Le script scripts/deploy-server.sh appelle wrangler avec ces variables.
# CLOUDFLARE_API_TOKEN : crée un token sur https://dash.cloudflare.com/profile/api-tokens
#   avec UNIQUEMENT la permission "Cloudflare Pages:Edit" (principe du moindre privilège).
# CLOUDFLARE_ACCOUNT_ID : visible en bas à droite du dashboard Cloudflare.
# CLOUDFLARE_PAGES_PROJECT : nom du projet Pages (ex: agri-pilot-v2).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PAGES_PROJECT="agri-pilot-v2"
