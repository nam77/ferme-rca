// Schéma Prisma — Ferme Agropastorale RCA
// Modèles initiaux : utilisateurs, tâches, zones, budget, photos, mouvements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  responsable
  ouvrier
  investisseur
}

enum Filiere {
  pisciculture
  aviculture
  porcins
  caprins
  cultures
  infrastructure
  habitat
}

enum Statut {
  a_faire
  en_cours
  termine
}

enum Priorite {
  haute
  moyenne
  basse
}

enum Phase {
  phase_1_infrastructure
  phase_2_lancement
  phase_3_exploitation
}

enum StatutZone {
  operationnel
  en_construction
  planifie
}

enum Espece {
  poulet
  porc
  caprin
  ovin
  tilapia
  clarias
}

enum SexeAnimal {
  male
  femelle
  mixte
}

enum CategorieAge {
  jeune
  croissance
  adulte
  reforme
}

enum TypeMouvementAnimal {
  achat
  naissance
  vente
  mortalite
  consommation_interne
  reforme
  transfert_entree
  transfert_sortie
  maladie
  vaccination
  traitement_sanitaire
  croisement
  pesee
}

enum TypeCulture {
  mais
  manioc
  arachide
  legumes
  brachiaria
  bananier
  jachere
}

enum StatutParcelle {
  preparation
  semis
  croissance
  recolte
  jachere
  abandonnee
}

enum TypeEvenementCulture {
  preparation_sol
  semis
  fertilisation
  irrigation
  traitement
  desherbage
  recolte
  observation
}

enum TypeJourCRA {
  travail
  absence
  conge
  maladie
  formation
  ferie
}

enum CategorieProduit {
  animal_vivant
  viande
  oeuf
  lait
  poisson
  cereale
  manioc
  legume
  fruit
  fourrage
  autre
}

enum UniteProduit {
  kg
  tete
  litre
  unite
  douzaine
  sac
  caisse
}

model Utilisateur {
  id              String   @id @default(cuid())
  email           String   @unique
  motDePasseHash  String
  prenom          String
  nom             String
  // Numéro de téléphone du salarié (au format libre, ex : "+236 75 12 34 56").
  // Optionnel pour les comptes existants qui n'en ont pas.
  telephone       String?
  role            Role     @default(ouvrier)
  filiere         Filiere?
  actif           Boolean  @default(true)
  creeLe          DateTime @default(now())
  modifieLe       DateTime @updatedAt

  tachesAssignees Tache[]      @relation("TacheResponsable")
  tachesCreees    Tache[]      @relation("TacheCreateur")
  mouvements      Mouvement[]
  photosTelechargees Photo[]   @relation("PhotoUploader")
  mouvementsAnimauxCrees MouvementAnimal[] @relation("AuteurMouvementAnimal")
  evenementsCultureCrees EvenementCulture[] @relation("AuteurEvenementCulture")
  saisiesCRA             SaisieJourCRA[]
  saisiesCRASupervisees  SaisieJourCRA[]    @relation("ResponsableCRA")
  ventesEnregistrees     Vente[]            @relation("EnregistreurVente")
}

model Tache {
  id            String   @id @default(cuid())
  titre         String
  description   String?
  filiere       Filiere
  priorite      Priorite @default(moyenne)
  statut        Statut   @default(a_faire)
  dateLimite    DateTime?
  dateDebut     DateTime?
  dateFinReelle DateTime?
  // Suivi financier par tâche (XAF, sans centimes — Decimal pour cohérence
  // avec LigneBudget). montantBudget = enveloppe allouée à la tâche.
  // montantDepense = total dépensé. Le solde se calcule côté client.
  montantBudget   Decimal? @db.Decimal(12, 2)
  montantDepense  Decimal? @db.Decimal(12, 2)
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  responsableId String?
  responsable   Utilisateur? @relation("TacheResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  createurId    String
  createur      Utilisateur  @relation("TacheCreateur", fields: [createurId], references: [id])

  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  mouvements    Mouvement[]
  sousTaches    SousTache[]

  @@index([statut])
  @@index([filiere])
  @@index([responsableId])
}

model SousTache {
  id        String   @id @default(cuid())
  titre     String
  faite     Boolean  @default(false)
  ordre     Int      @default(0)
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  tacheId   String
  tache     Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
}

model Zone {
  id           String     @id @default(cuid())
  nom          String
  filiere      Filiere
  surface      Float?     // en m²
  description  String?
  positionX    Float      @default(50) // % sur le plan
  positionY    Float      @default(50) // % sur le plan
  statut       StatutZone @default(operationnel)
  creeLe       DateTime   @default(now())
  modifieLe    DateTime   @updatedAt

  taches       Tache[]
  photos       Photo[]
  lots         LotAnimaux[]
  parcelles    Parcelle[]
}

model LotAnimaux {
  id            String       @id @default(cuid())
  nom           String
  espece        Espece
  sexe          SexeAnimal?
  categorieAge  CategorieAge @default(adulte)
  dateNaissance DateTime?
  notes         String?
  actif         Boolean      @default(true)
  creeLe        DateTime     @default(now())
  modifieLe     DateTime     @updatedAt

  zoneId        String?
  zone          Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  mouvements    MouvementAnimal[]

  @@index([espece])
  @@index([zoneId])
  @@index([actif])
}

model MouvementAnimal {
  id              String              @id @default(cuid())
  type            TypeMouvementAnimal
  quantite        Int
  dateMouvement   DateTime            @default(now())
  coutTotal       Decimal?            @db.Decimal(12, 2)
  devise          String              @default("XAF")
  motif           String?
  notes           String?
  creeLe          DateTime            @default(now())

  // Champs détaillés (optionnels) pour enrichir chaque type de mouvement
  poidsMoyenKg    Float?              // poids moyen par tête (achat/vente/pesée/naissance)
  prixUnitaire    Decimal?            @db.Decimal(12, 2) // FCFA/tête (achat/vente)
  tiersExterne    String?             // fournisseur/acheteur/vétérinaire/marché
  cause           String?             // cause de mortalité/maladie
  traitement      String?             // médicament/vaccin administré
  geniteurMaleLotId   String?         // pour naissance / croisement
  geniteurFemelleLotId String?

  lotId           String
  lot             LotAnimaux          @relation(fields: [lotId], references: [id], onDelete: Cascade)

  auteurId        String
  auteur          Utilisateur         @relation("AuteurMouvementAnimal", fields: [auteurId], references: [id])

  // Lien optionnel pour les transferts (sortie ↔ entrée)
  mouvementLieId  String?             @unique
  mouvementLie    MouvementAnimal?    @relation("TransfertAnimal", fields: [mouvementLieId], references: [id])
  mouvementOppose MouvementAnimal?    @relation("TransfertAnimal")

  @@index([lotId])
  @@index([dateMouvement])
  @@index([type])
}

model Parcelle {
  id                String         @id @default(cuid())
  nom               String
  typeCulture       TypeCulture
  surfaceHa         Float
  dateSemis         DateTime?
  dateRecoltePrev   DateTime?
  rendementPrevuKg  Float?
  rendementReelKg   Float?
  statut            StatutParcelle @default(preparation)
  notes             String?
  actif             Boolean        @default(true)
  creeLe            DateTime       @default(now())
  modifieLe         DateTime       @updatedAt

  zoneId            String?
  zone              Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  evenements        EvenementCulture[]

  @@index([typeCulture])
  @@index([statut])
  @@index([zoneId])
}

model EvenementCulture {
  id            String                @id @default(cuid())
  type          TypeEvenementCulture
  dateEvenement DateTime              @default(now())
  description   String?
  coutTotal     Decimal?              @db.Decimal(12, 2)
  devise        String                @default("XAF")
  quantiteKg    Float?
  notes         String?
  creeLe        DateTime              @default(now())

  parcelleId    String
  parcelle      Parcelle              @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  auteurId      String
  auteur        Utilisateur           @relation("AuteurEvenementCulture", fields: [auteurId], references: [id])

  @@index([parcelleId])
  @@index([dateEvenement])
  @@index([type])
}

model Vente {
  id            String           @id @default(cuid())
  produit       String           // libellé du produit ("Chèvre 18 kg", "Maïs grain", "Œufs frais", ...)
  categorie     CategorieProduit
  prixUnitaire  Decimal          @db.Decimal(12, 2)
  quantite      Float            // float pour permettre 12.5 kg, 0.75 sac, etc.
  unite         UniteProduit     @default(unite)
  prixTotal     Decimal          @db.Decimal(14, 2) // = prixUnitaire * quantite (stocké pour requêtes rapides)
  devise        String           @default("XAF")
  dateVente     DateTime         @default(now())
  client        String?
  notes         String?
  creeLe        DateTime         @default(now())
  modifieLe     DateTime         @updatedAt

  enregistreurId String?
  enregistreur   Utilisateur?    @relation("EnregistreurVente", fields: [enregistreurId], references: [id], onDelete: SetNull)

  @@index([dateVente])
  @@index([categorie])
}

model SaisieJourCRA {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  type          TypeJourCRA @default(travail)
  heures        Float       @default(8)
  notes         String?
  // Description libre de l'activité réalisée (planté maïs, vacciné poulets...)
  activite      String?
  // URL relative servies par /uploads/photos-cra/...
  photoDebut    String?
  photoFin      String?
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Superviseur qui a validé la journée (optionnel)
  responsableCRAId String?
  responsableCRA   Utilisateur? @relation("ResponsableCRA", fields: [responsableCRAId], references: [id], onDelete: SetNull)

  @@unique([utilisateurId, date])
  @@index([date])
  @@index([utilisateurId])
  @@index([responsableCRAId])
}

model BudgetLigne {
  id            String   @id @default(cuid())
  phase         Phase
  categorie     String
  description   String?
  montantPrevu  Decimal  @db.Decimal(12, 2)
  montantReel   Decimal  @default(0) @db.Decimal(12, 2)
  devise        String   @default("XAF") // Franc CFA d'Afrique centrale
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  @@index([phase])
}

model Photo {
  id         String   @id @default(cuid())
  url        String
  legende    String?
  creeLe     DateTime @default(now())

  zoneId     String?
  zone       Zone?    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  uploaderId String?
  uploader   Utilisateur? @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
}

model Mouvement {
  id           String   @id @default(cuid())
  ancienStatut Statut
  nouveauStatut Statut
  creeLe       DateTime @default(now())

  tacheId      String
  tache        Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  auteurId     String
  auteur       Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([tacheId])
}
